{
  "description": "Claude-Codex Review Bridge: automated code review via Codex CLI",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/codex-review-stop.sh"],
            "timeout": 150,
            "statusMessage": "CRB: Codex reviewing diff..."
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/codex-review-batch.sh"],
            "timeout": 150,
            "statusMessage": "CRB: Codex reviewing change batch..."
          }
        ]
      }
    ]
  }
}
